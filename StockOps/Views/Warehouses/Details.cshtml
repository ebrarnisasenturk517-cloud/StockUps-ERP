@model StockOps.Models.Warehouse

@{
    ViewData["Title"] = "Depo Detayları";

    decimal totalStock = Model.WarehouseStocks?
        .Sum(x => x.Quantity) ?? 0;

    decimal reservedStock = Model.WarehouseStocks?
        .Sum(x => x.ReservedQuantity) ?? 0;

    decimal availableStock = totalStock - reservedStock;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@Model.Name</h2>

            <p class="text-muted mb-0">
                Depo kodu: @Model.WarehouseCode
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Depoyu Düzenle
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Listeye Dön
            </a>

        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <p class="text-muted mb-1">
                        Toplam Kapasite
                    </p>

                    <h4 class="fw-bold mb-0">
                        @Model.TotalCapacity.ToString("N2")
                    </h4>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <p class="text-muted mb-1">
                        Toplam Stok
                    </p>

                    <h4 class="fw-bold mb-0">
                        @totalStock.ToString("N3")
                    </h4>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <p class="text-muted mb-1">
                        Rezerve Stok
                    </p>

                    <h4 class="fw-bold mb-0">
                        @reservedStock.ToString("N3")
                    </h4>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <p class="text-muted mb-1">
                        Kullanılabilir Stok
                    </p>

                    <h4 class="fw-bold mb-0">
                        @availableStock.ToString("N3")
                    </h4>

                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Depo Bilgileri</h5>
                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-4">Depo Kodu</dt>
                        <dd class="col-sm-8">@Model.WarehouseCode</dd>

                        <dt class="col-sm-4">Depo Adı</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Konum</dt>
                        <dd class="col-sm-8">@Model.Location</dd>

                        <dt class="col-sm-4">Kapasite</dt>
                        <dd class="col-sm-8">
                            @Model.TotalCapacity.ToString("N2")
                        </dd>

                        <dt class="col-sm-4">Durum</dt>
                        <dd class="col-sm-8">

                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    Aktif
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Pasif
                                </span>
                            }

                        </dd>

                    </dl>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Operasyon Özeti</h5>
                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between border-bottom py-3">
                        <span>Depo Bölgesi</span>
                        <strong>@(Model.WarehouseZones?.Count ?? 0)</strong>
                    </div>

                    <div class="d-flex justify-content-between border-bottom py-3">
                        <span>Forklift Sayısı</span>
                        <strong>@(Model.Forklifts?.Count ?? 0)</strong>
                    </div>

                    <div class="d-flex justify-content-between border-bottom py-3">
                        <span>Stok Kalemi</span>
                        <strong>@(Model.WarehouseStocks?.Count ?? 0)</strong>
                    </div>

                    <div class="d-flex justify-content-between py-3">
                        <span>Durum</span>

                        <strong>
                            @(Model.IsActive
                                ? "Operasyona Açık"
                                : "Operasyona Kapalı")
                        </strong>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Depodaki Ürünler</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.WarehouseStocks == null ||
                 !Model.WarehouseStocks.Any())
            {
                <div class="text-center text-muted py-5">
                    Bu depoya henüz stok kaydı eklenmemiş.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Ürün Kodu</th>
                                <th>Ürün</th>
                                <th>Toplam</th>
                                <th>Rezerve</th>
                                <th>Kullanılabilir</th>
                                <th>Son Güncelleme</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var stock in Model.WarehouseStocks)
                            {
                                <tr>
                                    <td>
                                        @stock.Product?.ProductCode
                                    </td>

                                    <td>
                                        @stock.Product?.Name
                                    </td>

                                    <td>
                                        @stock.Quantity.ToString("N3")
                                    </td>

                                    <td>
                                        @stock.ReservedQuantity.ToString("N3")
                                    </td>

                                    <td>
                                        @{
                                            var available =
                                                stock.Quantity -
                                                stock.ReservedQuantity;
                                        }

                                        @available.ToString("N3")
                                    </td>

                                    <td>
                                        @stock.LastUpdatedAt
                                        .ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>