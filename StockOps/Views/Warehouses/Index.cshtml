@{
    ViewData["Title"] = "Depolar & Ambarlar";
}

<div class="module-header">
    <div>
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-warehouse me-2"></i>Depo ve Ambar Tanımları</h4>
        <p class="mb-0 text-white-50 small">Fabrika Sahası Ambar, Raf ve Bölge (Zone) Yapılandırması</p>
    </div>
    <a href="/Warehouses/Create" class="btn btn-primary fw-bold btn-sm px-3">
        <i class="fa-solid fa-plus me-1"></i> Yeni Depo Ekle
    </a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 border-top border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold m-0"><i class="fa-solid fa-boxes-packing me-2 text-primary"></i>A-Blok Mamul Ambarı</h6>
                <span class="badge bg-success">Aktif</span>
            </div>
            <p class="text-muted small mb-2">Kapasite Doluluk Oranı: %78</p>
            <div class="progress mb-3" style="height: 6px;">
                <div class="progress-bar bg-primary" style="width: 78%;"></div>
            </div>
            <a href="/Warehousezones/Index?warehouseId=1" class="btn btn-outline-dark btn-sm fw-bold w-100"><i class="fa-solid fa-layer-group me-1"></i> Bölgeleri (Zones) Gör</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 border-top border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold m-0"><i class="fa-solid fa-dumpster me-2 text-warning"></i>Hurda Sahası Deposu</h6>
                <span class="badge bg-success">Aktif</span>
            </div>
            <p class="text-muted small mb-2">Kapasite Doluluk Oranı: %42</p>
            <div class="progress mb-3" style="height: 6px;">
                <div class="progress-bar bg-warning" style="width: 42%;"></div>
            </div>
            <a href="/Warehousezones/Index?warehouseId=2" class="btn btn-outline-dark btn-sm fw-bold w-100"><i class="fa-solid fa-layer-group me-1"></i> Bölgeleri (Zones) Gör</a>
        </div>
    </div>
</div>