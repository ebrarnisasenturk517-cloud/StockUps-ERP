@model StockOps.Models.Warehouse

@{
    ViewData["Title"] = "Depo Düzenle";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Depo Düzenle</h2>
                    <p class="text-muted mb-0">
                        Depo bilgilerini ve durumunu güncelleyin.
                    </p>
                </div>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Listeye Dön
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="Edit" method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="WarehouseCode"
                                       class="form-label">
                                    Depo Kodu
                                </label>

                                <input asp-for="WarehouseCode"
                                       class="form-control" />

                                <span asp-validation-for="WarehouseCode"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Name"
                                       class="form-label">
                                    Depo Adı
                                </label>

                                <input asp-for="Name"
                                       class="form-control" />

                                <span asp-validation-for="Name"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>

                        <div class="mb-3">
                            <label asp-for="Location"
                                   class="form-label">
                                Depo Konumu
                            </label>

                            <input asp-for="Location"
                                   class="form-control" />

                            <span asp-validation-for="Location"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TotalCapacity"
                                   class="form-label">
                                Toplam Kapasite
                            </label>

                            <input asp-for="TotalCapacity"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control" />

                            <span asp-validation-for="TotalCapacity"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="form-check form-switch mb-4">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Depo aktif
                            </label>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-light">
                                İptal
                            </a>

                            <button type="submit"
                                    class="btn btn-warning">
                                Değişiklikleri Kaydet
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}