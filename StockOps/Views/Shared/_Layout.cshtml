<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StockOps ERP</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
            :root {
                --navy-dark: #0b1329;
                --navy-slate: #0f172a;
                --navy-light: #1e293b;
                --navy-accent: #2563eb;
                --navy-cyan: #38bdf8;
                --border-color: #e2e8f0;
                --bg-light: #f8fafc;
                --sidebar-width: 260px;
            }

            html {
                min-height: 100%;
            }

            body {
                min-height: 100vh;
                margin: 0;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
                background-color: var(--bg-light);
                color: #334155;
            }

            .navbar-corporate {
                min-height: 64px;
                background-color: var(--navy-dark);
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                box-shadow: 0 3px 12px rgba(15, 23, 42, 0.22);
                z-index: 1030;
            }

            .navbar-brand {
                color: #ffffff !important;
                font-weight: 800;
            }

                .navbar-brand span {
                    color: var(--navy-cyan);
                }

            .user-information {
                display: flex;
                align-items: center;
                gap: 8px;
                color: #e2e8f0;
            }

            .application-layout {
                display: flex;
                min-height: calc(100vh - 64px);
            }

            .sidebar-wrapper {
                width: var(--sidebar-width);
                flex-shrink: 0;
                padding: 18px 10px;
                background-color: var(--navy-slate);
                color: #94a3b8;
            }

            .sidebar-title {
                padding: 8px 14px 12px;
                color: #64748b;
                font-size: 0.72rem;
                font-weight: 800;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 4px 0;
                padding: 11px 14px;
                border-radius: 9px;
                color: #cbd5e1;
                text-decoration: none;
                font-size: 0.91rem;
                font-weight: 600;
                transition: 0.2s ease;
            }

                .sidebar-link i {
                    width: 21px;
                    text-align: center;
                }

                .sidebar-link:hover {
                    color: #ffffff;
                    background-color: var(--navy-light);
                    transform: translateX(3px);
                }

                .sidebar-link.active {
                    color: #ffffff;
                    background-color: var(--navy-accent);
                    box-shadow: 0 5px 14px rgba(37, 99, 235, 0.28);
                }

            .sidebar-divider {
                margin: 16px 10px;
                border-color: rgba(255, 255, 255, 0.08);
            }

            .main-content {
                width: calc(100% - var(--sidebar-width));
                min-width: 0;
                padding: 25px;
            }

            .main-content-home {
                width: 100%;
                min-width: 0;
                padding: 0;
            }

            .content-alert {
                margin-bottom: 20px;
            }

            @@media (max-width: 991.98px) {
                .application-layout {
                    display: block;
                }

                .sidebar-wrapper {
                    width: 100%;
                    min-height: auto;
                }

                .main-content {
                    width: 100%;
                    padding: 18px;
                }
            }
    </style>
</head>

<body>

    @{
        var username =
            Context.Session.GetString("Username") ?? "";

        var role =
            Context.Session.GetString("Role") ?? "";

        var currentController =
            ViewContext.RouteData.Values["controller"]?
                .ToString() ?? "";

        var currentAction =
            ViewContext.RouteData.Values["action"]?
                .ToString() ?? "";

        var isHomePage =
            string.Equals(
                currentController,
                "Home",
                StringComparison.OrdinalIgnoreCase);

        string ActiveMenu(string controller)
        {
            return string.Equals(
                currentController,
                controller,
                StringComparison.OrdinalIgnoreCase)
                    ? "active"
                    : "";
        }
    }

    <!-- ÜST BAR -->
    <nav class="navbar navbar-dark navbar-corporate sticky-top px-3">

        <div class="container-fluid">

            <a class="navbar-brand fs-4"
               asp-controller="Home"
               asp-action="Index">

                <i class="fa-solid fa-cubes-stacked
                me-2 text-primary"></i>

                Stock<span>Ops</span> ERP
            </a>

            <div class="d-flex align-items-center gap-3">

                @if (!isHomePage &&
                     !string.IsNullOrWhiteSpace(username))
                {
                    <div class="user-information d-none d-md-flex">

                        <i class="fa-solid fa-user-gear"></i>

                        <span>
                            @username (@role)
                        </span>

                    </div>

                    <a asp-controller="Auth"
                       asp-action="Logout"
                       class="btn btn-outline-light btn-sm">

                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Çıkış
                    </a>
                }
                else if (isHomePage &&
                         string.IsNullOrWhiteSpace(username))
                {
                    <a asp-controller="Auth"
                       asp-action="Login"
                       class="btn btn-outline-light btn-sm">

                        <i class="fa-solid fa-right-to-bracket me-1"></i>
                        Giriş
                    </a>
                }
                else if (isHomePage &&
                         !string.IsNullOrWhiteSpace(username))
                {
                    <a asp-controller="Auth"
                       asp-action="Logout"
                       class="btn btn-outline-light btn-sm">

                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Çıkış
                    </a>
                }

            </div>

        </div>

    </nav>

    <div class="application-layout">

        @if (!isHomePage &&
             !string.IsNullOrWhiteSpace(username))
        {
            <aside class="sidebar-wrapper">

                @if (role == "Admin")
                {
                    <div class="sidebar-title">
                        Ana Menü
                    </div>

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Admin")">

                        <i class="fa-solid fa-gauge-high"></i>
                        Yönetim Merkezi
                    </a>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Dashboard")">

                        <i class="fa-solid fa-chart-line"></i>
                        Dashboard
                    </a>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Products")">

                        <i class="fa-solid fa-boxes-stacked"></i>
                        Ürün Kataloğu
                    </a>

                    <a asp-controller="Requests"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Requests")">

                        <i class="fa-solid fa-file-signature"></i>
                        İç Talepler
                    </a>

                    <hr class="sidebar-divider" />

                    <div class="sidebar-title">
                        Depo Operasyonları
                    </div>

                    <a asp-controller="Warehouses"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Warehouses")">

                        <i class="fa-solid fa-warehouse"></i>
                        Depolar
                    </a>

                    <a asp-controller="WarehouseZones"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("WarehouseZones")">

                        <i class="fa-solid fa-layer-group"></i>
                        Depo Bölgeleri
                    </a>

                    <a asp-controller="StorageLocations"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("StorageLocations")">

                        <i class="fa-solid fa-table-cells-large"></i>
                        Raf ve Lokasyonlar
                    </a>

                    <a asp-controller="StockTransactions"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("StockTransactions")">

                        <i class="fa-solid fa-arrow-right-arrow-left"></i>
                        Stok Hareketleri
                    </a>

                    <a asp-controller="Products"
                       asp-action="CriticalStock"
                       class="sidebar-link">

                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Kritik Stok
                    </a>

                    <hr class="sidebar-divider" />

                    <div class="sidebar-title">
                        Yönetim
                    </div>

                    <a asp-controller="Purchasing"
                       asp-action="Dashboard"
                       class="sidebar-link @ActiveMenu("Purchasing")">

                        <i class="fa-solid fa-cart-shopping"></i>
                        Satın Alma
                    </a>

                    <a asp-controller="Users"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Users")">

                        <i class="fa-solid fa-users"></i>
                        Kullanıcı Yönetimi
                    </a>

                    <a asp-controller="Reports"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Reports")">

                        <i class="fa-solid fa-chart-pie"></i>
                        Raporlar
                    </a>

                    <a asp-controller="Excel"
                       asp-action="Import"
                       class="sidebar-link @ActiveMenu("Excel")">

                        <i class="fa-solid fa-file-excel"></i>
                        Excel İşlemleri
                    </a>
                }
                else if (role == "Depo")
                {
                    <div class="sidebar-title">
                        Depo Menü
                    </div>

                    <a asp-controller="Worker"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Worker")">

                        <i class="fa-solid fa-gauge-high"></i>
                        Depo Paneli
                    </a>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Products")">

                        <i class="fa-solid fa-boxes-stacked"></i>
                        Ürünler
                    </a>

                    <a asp-controller="Requests"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Requests")">

                        <i class="fa-solid fa-file-signature"></i>
                        Talepler
                    </a>

                    <a asp-controller="Requests"
                       asp-action="StockOutWaiting"
                       class="sidebar-link">

                        <i class="fa-solid fa-box-open"></i>
                        Stok Çıkışları
                    </a>

                    <a asp-controller="Products"
                       asp-action="CriticalStock"
                       class="sidebar-link">

                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Kritik Stoklar
                    </a>
                }
                else if (role == "SatinAlma")
                {
                    <div class="sidebar-title">
                        Satın Alma
                    </div>

                    <a asp-controller="Purchasing"
                       asp-action="Dashboard"
                       class="sidebar-link @ActiveMenu("Purchasing")">

                        <i class="fa-solid fa-cart-shopping"></i>
                        Satın Alma Paneli
                    </a>

                    <a asp-controller="Purchasing"
                       asp-action="DepoTalepleri"
                       class="sidebar-link">

                        <i class="fa-solid fa-inbox"></i>
                        Depo Talepleri
                    </a>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="sidebar-link @ActiveMenu("Products")">

                        <i class="fa-solid fa-boxes-stacked"></i>
                        Ürünler
                    </a>

                    <a asp-controller="Products"
                       asp-action="CriticalStock"
                       class="sidebar-link">

                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Kritik Stok
                    </a>

                    <a asp-controller="Excel"
                       asp-action="Import"
                       class="sidebar-link">

                        <i class="fa-solid fa-file-excel"></i>
                        Excel İşlemleri
                    </a>
                }

            </aside>
        }

        <main class="@(isHomePage
                                    ? "main-content-home"
                                    : "main-content")">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success
                    alert-dismissible fade show
                    content-alert"
                     role="alert">

                    <i class="fa-solid fa-circle-check me-1"></i>

                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Kapat">
                    </button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger
                    alert-dismissible fade show
                    content-alert"
                     role="alert">

                    <i class="fa-solid fa-circle-exclamation me-1"></i>

                    @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Kapat">
                    </button>
                </div>
            }

            @RenderBody()

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script>
            window.setTimeout(function() {
                const alerts =
                    document.querySelectorAll(".content-alert");

                alerts.forEach(function(alertElement) {
                    const alert =
                        bootstrap.Alert.getOrCreateInstance(alertElement);

                    alert.close();
                });
            }, 4000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>