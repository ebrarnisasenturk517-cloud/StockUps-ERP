@{
    ViewData["Title"] = "StockOps ERP Giriş";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StockOps ERP - Kurumsal Giriş</title>

    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            /* ==========================================================================
                       KURUMSAL LACİVERT GİRİŞ SİSTEMİ (EXECUTIVE NAVY)
                       ========================================================================== */
            :root {
                --navy-dark: #0b1329;
                --navy-card: rgba(15, 23, 42, 0.82);
                --navy-border: rgba(255, 255, 255, 0.12);
                --navy-accent: #2563eb;
                --navy-accent-hover: #1d4ed8;
                --navy-cyan: #38bdf8;
                --text-bright: #ffffff;
                --text-muted: #94a3b8;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                background: #0b1329 url('/images/factory-bg.jpg') center center / cover no-repeat fixed;
                display: flex;
                justify-content: center;
                align-items: center;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            }

                /* FABRİKA ARKA PLANINA DERİN LACİVERT KARARTMA */
                body::before {
                    content: "";
                    position: fixed;
                    inset: 0;
                    background: radial-gradient(circle at 50% 50%, rgba(11, 19, 41, 0.78) 0%, rgba(5, 10, 24, 0.94) 100%);
                    z-index: -1;
                }

            .login-card {
                width: 100%;
                max-width: 440px;
                padding: 45px 40px;
                background: var(--navy-card);
                backdrop-filter: blur(20px) saturate(180%);
                -webkit-backdrop-filter: blur(20px) saturate(180%);
                border: 1px solid var(--navy-border);
                border-radius: 20px;
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
                color: var(--text-bright);
            }

            /* LOGO BÖLÜMÜ */
            .logo {
                text-align: center;
                margin-bottom: 30px;
            }

                .logo h1 {
                    font-size: 2.5rem;
                    font-weight: 900;
                    letter-spacing: -1px;
                    margin: 0;
                    color: var(--text-bright);
                }

                    .logo h1 span {
                        color: var(--navy-cyan);
                    }

                .logo p {
                    margin-top: 6px;
                    color: var(--text-muted);
                    font-size: 0.88rem;
                    font-weight: 500;
                }

            /* İNPUT VE ETİKET DÜZENLERİ */
            .form-label {
                color: #e2e8f0;
                font-weight: 600;
                font-size: 0.85rem;
                margin-bottom: 8px;
            }

            .input-group-custom {
                position: relative;
                margin-bottom: 20px;
            }

                .input-group-custom i {
                    position: absolute;
                    left: 18px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                    font-size: 1.1rem;
                    z-index: 5;
                    transition: color 0.2s ease;
                }

            .form-control-custom {
                width: 100%;
                height: 52px;
                padding-left: 48px;
                padding-right: 18px;
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid var(--navy-border);
                border-radius: 12px;
                font-size: 0.95rem;
                color: #ffffff !important;
                transition: all 0.25s ease;
            }

                .form-control-custom::placeholder {
                    color: #64748b;
                }

                .form-control-custom:focus {
                    outline: none;
                    background: rgba(255, 255, 255, 0.1);
                    border-color: var(--navy-cyan);
                    box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.15);
                }

                    .form-control-custom:focus + i {
                        color: var(--navy-cyan);
                    }

            /* GİRİŞ BUTONU */
            .btn-login {
                background: var(--navy-accent);
                color: #ffffff !important;
                border: none;
                border-radius: 12px;
                height: 52px;
                font-weight: 700;
                font-size: 1rem;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                transition: all 0.25s ease;
                box-shadow: 0 4px 15px rgba(37, 99, 235, 0.35);
            }

                .btn-login:hover {
                    background: var(--navy-accent-hover);
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.45);
                }

            /* ROL & DİPNOT BİLGİLERİ */
            .roles-badge-container {
                display: flex;
                justify-content: center;
                gap: 8px;
                margin-top: 25px;
            }

            .role-badge {
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid var(--navy-border);
                color: var(--text-muted);
                font-size: 0.75rem;
                font-weight: 700;
                padding: 4px 10px;
                border-radius: 6px;
            }

            .footer-text {
                text-align: center;
                margin-top: 20px;
                font-size: 0.78rem;
                color: #64748b;
                font-weight: 500;
            }
    </style>
</head>
<body>

    <div class="login-card">

        <!-- LOGO BÖLÜMÜ -->
        <div class="logo">
            <h1>Stock<span>Ops</span></h1>
            <p>Çelik Fabrikası ERP Stok Yönetimi</p>
        </div>

        <!-- HATA BİLDİRİMİ -->
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 text-white bg-danger bg-opacity-75 py-2 px-3 rounded-3 small mb-3">
                <i class="fa-solid fa-circle-exclamation me-1"></i> @ViewBag.Error
            </div>
        }

        <form method="post">

            <!-- KULLANICI ADI -->
            <div class="mb-3">
                <label class="form-label">Kullanıcı Adı</label>
                <div class="input-group-custom">
                    <input type="text"
                           name="username"
                           class="form-control-custom"
                           placeholder="Kullanıcı adınızı giriniz"
                           required
                           autocomplete="off" />
                    <i class="fa-solid fa-user"></i>
                </div>
            </div>

            <!-- ŞİFRE -->
            <div class="mb-4">
                <label class="form-label">Şifre</label>
                <div class="input-group-custom">
                    <input type="password"
                           name="password"
                           class="form-control-custom"
                           placeholder="••••••••"
                           required />
                    <i class="fa-solid fa-lock"></i>
                </div>
            </div>

            <!-- GİRİŞ BUTONU -->
            <button type="submit" class="btn btn-login w-100">
                <span>Sisteme Giriş Yap</span>
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
            </button>

        </form>

        <!-- YETKİLİ ROLLER -->
        <div class="roles-badge-container">
            <span class="role-badge">Admin</span>
            <span class="role-badge">Depo</span>
            <span class="role-badge">Satın Alma</span>
        </div>

        <!-- FOOTER -->
        <div class="footer-text">
            StockOps ERP • Kurumsal Güvenlik Servisleri © 2026
        </div>

    </div>

</body>
</html>