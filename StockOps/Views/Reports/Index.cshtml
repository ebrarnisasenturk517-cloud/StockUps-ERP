@model List<StockOps.Models.Product>

@{
    ViewData["Title"] = "RAPORLAMA";
    var categoryReports = ViewBag.CategoryReports;
}

<style>
    .page-header {
        color: white;
        font-size: 34px;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 15px;
    }

    .page-subtitle {
        color: #e5e7eb;
        font-weight: 600;
        margin-bottom: 30px;
    }

    .report-card {
        background: rgba(255,255,255,0.95);
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.18);
        height: 100%;
    }

    .report-card h6 {
        color: #111827;
        font-weight: 900;
        text-transform: uppercase;
        font-size: 16px;
    }

    .report-card h2 {
        color: #111827;
        font-weight: 900;
        font-size: 38px;
    }

    .chart-bar {
        background: #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
        height: 28px;
    }

    .chart-fill {
        background: #ffc107;
        height: 28px;
        font-weight: 900;
        color: #111827;
        padding-left: 10px;
        line-height: 28px;
    }

    .table thead th {
        background: #111827;
        color: white;
        font-weight: 900;
        text-transform: uppercase;
    }

    .table tbody td {
        color: #111827;
        font-weight: 600;
    }
</style>

<h2 class="page-header">
    STOK RAPORLAMA MERKEZİ
</h2>

<p class="page-subtitle">
    Stok seviyeleri, kritik ürünler ve kategori bazlı stok dağılımları bu ekrandan takip edilir.
</p>

<div class="row g-4 mb-5">

    <div class="col-md-3">
        <div class="report-card text-center">
            <h6>TOPLAM ÜRÜN</h6>
            <h2>@ViewBag.TotalProducts</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="report-card text-center">
            <h6>YETERLİ STOK</h6>
            <h2>@ViewBag.EnoughStock</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="report-card text-center">
            <h6>KRİTİK STOK</h6>
            <h2>@ViewBag.CriticalStock</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="report-card text-center">
            <h6>STOKTA YOK</h6>
            <h2>@ViewBag.OutOfStock</h2>
        </div>
    </div>

</div>

<div class="report-card mb-5">

    <h4 class="fw-bold mb-4">
        KATEGORİYE GÖRE STOK DAĞILIMI
    </h4>

    @foreach (var item in categoryReports)
    {
        int width = item.TotalStock;

        if (width > 100)
        {
            width = 100;
        }

        <div class="mb-3">
            <div class="d-flex justify-content-between">
                <strong>@item.Category</strong>
                <strong>@item.TotalStock adet</strong>
            </div>

            <div class="chart-bar mt-1">
                <div class="chart-fill" style="width:@width%">
                    @item.Category
                </div>
            </div>
        </div>
    }

</div>

<div class="report-card">

    <h4 class="fw-bold mb-4">
        KRİTİK STOKTAKİ ÜRÜNLER
    </h4>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ÜRÜN KODU</th>
                <th>ÜRÜN ADI</th>
                <th>KATEGORİ</th>
                <th>DEPO</th>
                <th>STOK</th>
                <th>DURUM</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductCode</td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.Warehouse</td>
                    <td>@item.StockQuantity</td>
                    <td>
                        <span class="badge bg-danger">
                            KRİTİK STOK
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>