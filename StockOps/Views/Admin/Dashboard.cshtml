@using StockOps.Models

@{
    ViewData["Title"] = "Yönetim Dashboard";

    var lastRequests = ViewBag.LastRequests as List<Request>;

    var totalProducts = ViewBag.TotalProducts ?? 0;
    var totalUsers = ViewBag.TotalUsers ?? 0;
    var pendingRequests = ViewBag.PendingRequests ?? 0;
    var criticalStock = ViewBag.CriticalStock ?? 0;
}

<style>
    .dashboard-page {
        padding-bottom: 35px;
    }

    .dashboard-hero {
        position: relative;
        overflow: hidden;
        margin-bottom: 25px;
        padding: 30px 34px;
        border-radius: 18px;
        color: #ffffff;
        background: linear-gradient( 135deg, #0b1329 0%, #0f172a 55%, #1e3a8a 100% );
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.18);
    }

        .dashboard-hero::after {
            content: "";
            position: absolute;
            top: -95px;
            right: -70px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(56, 189, 248, 0.18), transparent 70% );
        }

    .dashboard-hero-content {
        position: relative;
        z-index: 2;
    }

    .dashboard-title {
        margin-bottom: 8px;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .dashboard-description {
        max-width: 780px;
        margin: 0;
        color: #cbd5e1;
        line-height: 1.65;
    }

    .section-title {
        margin: 28px 0 15px;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .stat-card {
        height: 100%;
        padding: 23px;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 7px 18px rgba(15, 23, 42, 0.06);
        transition: 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(15, 23, 42, 0.10);
        }

    .stat-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .stat-label {
        margin-bottom: 5px;
        color: #64748b;
        font-size: 0.77rem;
        font-weight: 850;
        letter-spacing: 0.45px;
        text-transform: uppercase;
    }

    .stat-number {
        margin: 0;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 900;
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 49px;
        height: 49px;
        border-radius: 13px;
        color: #2563eb;
        background: #eff6ff;
        font-size: 1.15rem;
    }

        .stat-icon.warning {
            color: #d97706;
            background: #fffbeb;
        }

        .stat-icon.danger {
            color: #dc2626;
            background: #fef2f2;
        }

    .module-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 190px;
        padding: 24px;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        color: #334155;
        background: #ffffff;
        box-shadow: 0 7px 18px rgba(15, 23, 42, 0.06);
        text-decoration: none;
        transition: 0.22s ease;
    }

        .module-card:hover {
            border-color: #93c5fd;
            color: #0f172a;
            transform: translateY(-4px);
            box-shadow: 0 13px 26px rgba(15, 23, 42, 0.11);
        }

    .module-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 49px;
        height: 49px;
        margin-bottom: 17px;
        border-radius: 13px;
        color: #ffffff;
        background: linear-gradient( 135deg, #2563eb, #1d4ed8 );
        font-size: 1.15rem;
    }

    .module-card h5 {
        margin-bottom: 9px;
        color: #0f172a;
        font-size: 1.02rem;
        font-weight: 850;
    }

    .module-card p {
        flex-grow: 1;
        margin-bottom: 17px;
        color: #64748b;
        font-size: 0.9rem;
        line-height: 1.55;
    }

    .module-link-text {
        color: #2563eb;
        font-size: 0.85rem;
        font-weight: 800;
    }

    .warning-banner {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 22px;
        padding: 16px 18px;
        border: 1px solid #fecaca;
        border-radius: 13px;
        color: #991b1b;
        background: #fef2f2;
        font-weight: 700;
    }

    .requests-card {
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 7px 18px rgba(15, 23, 42, 0.06);
    }

    .requests-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 18px 21px;
        border-bottom: 1px solid #e2e8f0;
        background: #ffffff;
    }

        .requests-header h4 {
            margin: 0;
            color: #0f172a;
            font-size: 1rem;
            font-weight: 900;
            text-transform: uppercase;
        }

    .requests-count {
        padding: 5px 10px;
        border-radius: 20px;
        color: #475569;
        background: #f1f5f9;
        font-size: 0.78rem;
        font-weight: 800;
    }

    .requests-table {
        margin-bottom: 0;
    }

        .requests-table thead th {
            padding: 13px 16px;
            border-bottom: 1px solid #e2e8f0;
            color: #64748b;
            background: #f8fafc;
            font-size: 0.76rem;
            font-weight: 850;
            letter-spacing: 0.35px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .requests-table tbody td {
            padding: 14px 16px;
            color: #334155;
            vertical-align: middle;
        }

    .request-number {
        color: #2563eb;
        font-weight: 850;
    }

    .empty-state {
        padding: 50px 20px;
        color: #64748b;
        text-align: center;
    }

        .empty-state i {
            margin-bottom: 13px;
            color: #94a3b8;
            font-size: 2rem;
        }
</style>

<div class="dashboard-page">

    <section class="dashboard-hero">
        <div class="dashboard-hero-content">

            <h1 class="dashboard-title">
                Yönetim Dashboard
            </h1>

            <p class="dashboard-description">
                Sistem genel durumunu, ürünleri, kullanıcıları, talepleri
                ve kritik stok seviyelerini tek ekran üzerinden takip edin.
            </p>

        </div>
    </section>

    @if (Convert.ToInt32(criticalStock) > 0)
    {
        <div class="warning-banner">
            <i class="fa-solid fa-triangle-exclamation"></i>

            <span>
                Sistemde kritik stok seviyesine düşmüş
                @criticalStock ürün bulunmaktadır.
            </span>
        </div>
    }

    <h2 class="section-title">
        Sistem Özeti
    </h2>

    <div class="row g-4">

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">

                <div class="stat-card-header">

                    <div>
                        <div class="stat-label">
                            Toplam Ürün
                        </div>

                        <h3 class="stat-number">
                            @totalProducts
                        </h3>
                    </div>

                    <div class="stat-icon">
                        <i class="fa-solid fa-boxes-stacked"></i>
                    </div>

                </div>

            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">

                <div class="stat-card-header">

                    <div>
                        <div class="stat-label">
                            Toplam Kullanıcı
                        </div>

                        <h3 class="stat-number">
                            @totalUsers
                        </h3>
                    </div>

                    <div class="stat-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                </div>

            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">

                <div class="stat-card-header">

                    <div>
                        <div class="stat-label">
                            Bekleyen Talep
                        </div>

                        <h3 class="stat-number">
                            @pendingRequests
                        </h3>
                    </div>

                    <div class="stat-icon warning">
                        <i class="fa-solid fa-file-circle-question"></i>
                    </div>

                </div>

            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">

                <div class="stat-card-header">

                    <div>
                        <div class="stat-label">
                            Kritik Stok
                        </div>

                        <h3 class="stat-number">
                            @criticalStock
                        </h3>
                    </div>

                    <div class="stat-icon danger">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>

                </div>

            </div>
        </div>

    </div>

    <h2 class="section-title">
        Hızlı Yönetim Modülleri
    </h2>

    <div class="row g-4">

        <div class="col-xl-3 col-md-6">

            <a asp-controller="Products"
               asp-action="Index"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>

                <h5>Ürün Yönetimi</h5>

                <p>
                    Ürün kayıtlarını, stok miktarlarını,
                    barkod ve ürün kodlarını yönetin.
                </p>

                <span class="module-link-text">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

        <div class="col-xl-3 col-md-6">

            <a asp-controller="Users"
               asp-action="Index"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-users-gear"></i>
                </div>

                <h5>Kullanıcı Yönetimi</h5>

                <p>
                    Kullanıcı ekleme, düzenleme,
                    silme ve rol atama işlemlerini yapın.
                </p>

                <span class="module-link-text">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

        <div class="col-xl-3 col-md-6">

            <a asp-controller="Reports"
               asp-action="Index"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>

                <h5>Raporlama Merkezi</h5>

                <p>
                    Stok, talep ve kritik ürün
                    raporlarını görüntüleyin.
                </p>

                <span class="module-link-text">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

        <div class="col-xl-3 col-md-6">

            <a asp-controller="Requests"
               asp-action="StockOutWaiting"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-box-open"></i>
                </div>

                <h5>Stok Çıkışı Bekleyenler</h5>

                <p>
                    Onaylanan taleplerin stok çıkışı
                    işlemlerini merkezi olarak yönetin.
                </p>

                <span class="module-link-text">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

    </div>

    <h2 class="section-title">
        Son Talep Hareketleri
    </h2>

    <section class="requests-card">

        <div class="requests-header">

            <h4>
                <i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>
                Son Talepler
            </h4>

            <span class="requests-count">
                @(lastRequests?.Count ?? 0) kayıt
            </span>

        </div>

        @if (lastRequests == null || !lastRequests.Any())
        {
            <div class="empty-state">
                <i class="fa-regular fa-folder-open"></i>

                <h5>Talep kaydı bulunamadı</h5>

                <p class="mb-0">
                    Son talep hareketleri burada görüntülenecek.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover requests-table">

                    <thead>
                        <tr>
                            <th>Talep No</th>
                            <th>Ürün</th>
                            <th>Kullanıcı</th>
                            <th>Miktar</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in lastRequests)
                        {
                            <tr>

                                <td>
                                    <span class="request-number">
                                        #@item.Id
                                    </span>
                                </td>

                                <td>
                                    @(item.Product?.Name ?? "-")
                                </td>

                                <td>
                                    @(item.User?.Username ?? "-")
                                </td>

                                <td>
                                    @item.Quantity
                                </td>

                                <td>
                                    @if (item.Status == "Bekliyor")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Bekliyor
                                        </span>
                                    }
                                    else if (
                                        item.Status == "Onaylandı" ||
                                        item.Status == "Satın Alma Onayladı")
                                    {
                                        <span class="badge bg-success">
                                            Onaylandı
                                        </span>
                                    }
                                    else if (item.Status == "Reddedildi")
                                    {
                                        <span class="badge bg-danger">
                                            Reddedildi
                                        </span>
                                    }
                                    else if (item.Status == "Tedarik Bekliyor")
                                    {
                                        <span class="badge bg-info text-dark">
                                            Tedarik Bekliyor
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.RequestDate
                                    .ToString("dd.MM.yyyy HH:mm")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>