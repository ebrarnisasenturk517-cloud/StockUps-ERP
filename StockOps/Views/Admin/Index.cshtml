@{
    ViewData["Title"] = "Yönetici Paneli";
}

<style>
    .admin-dashboard {
        padding: 5px 0 35px;
    }

    .admin-hero {
        position: relative;
        overflow: hidden;
        margin-bottom: 25px;
        padding: 28px 32px;
        border-radius: 18px;
        color: #ffffff;
        background: linear-gradient( 135deg, #0b1329 0%, #0f172a 58%, #1e3a8a 100% );
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.20);
    }

        .admin-hero::after {
            content: "";
            position: absolute;
            top: -100px;
            right: -75px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(56, 189, 248, 0.16), transparent 70% );
        }

    .admin-hero-content {
        position: relative;
        z-index: 2;
    }

    .admin-page-title {
        margin-bottom: 8px;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.5px;
    }

    .admin-subtitle {
        max-width: 800px;
        margin: 0;
        color: #cbd5e1;
        line-height: 1.65;
    }

    .dashboard-section-title {
        margin: 28px 0 15px;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        letter-spacing: 0.4px;
        text-transform: uppercase;
    }

    .stat-card {
        height: 100%;
        padding: 23px;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        background: #ffffff;
        box-shadow: 0 7px 18px rgba(15, 23, 42, 0.06);
        transition: 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(15, 23, 42, 0.10);
        }

    .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 13px;
        color: #2563eb;
        background: #eff6ff;
        font-size: 1.15rem;
    }

    .stat-label {
        margin-bottom: 5px;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.45px;
        text-transform: uppercase;
    }

    .stat-number {
        margin: 0;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 900;
    }

    .module-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 195px;
        padding: 25px;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        color: #334155;
        background: #ffffff;
        box-shadow: 0 7px 18px rgba(15, 23, 42, 0.06);
        text-decoration: none;
        transition: 0.22s ease;
    }

        .module-card:hover {
            border-color: #93c5fd;
            color: #0f172a;
            transform: translateY(-4px);
            box-shadow: 0 13px 26px rgba(15, 23, 42, 0.11);
        }

    .module-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 49px;
        height: 49px;
        margin-bottom: 18px;
        border-radius: 13px;
        color: #ffffff;
        background: linear-gradient( 135deg, #2563eb, #1d4ed8 );
        font-size: 1.15rem;
    }

    .module-card h5 {
        margin-bottom: 9px;
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 850;
    }

    .module-card p {
        flex-grow: 1;
        margin-bottom: 18px;
        color: #64748b;
        font-size: 0.9rem;
        line-height: 1.55;
    }

    .module-action {
        color: #2563eb;
        font-size: 0.86rem;
        font-weight: 800;
    }
</style>

<div class="admin-dashboard">

    <section class="admin-hero">

        <div class="admin-hero-content">

            <h1 class="admin-page-title">
                StockOps ERP Yönetici Paneli
            </h1>

            <p class="admin-subtitle">
                Ürün, kullanıcı, talep, satın alma ve depo operasyonlarını
                tek panel üzerinden yönetin. Depo bölgeleri ve fiziksel
                lokasyonları takip edin.
            </p>

        </div>

    </section>

    <h2 class="dashboard-section-title">
        Sistem Özeti
    </h2>

    <div class="row g-4">

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">

                <div class="stat-top">

                    <div>
                        <div class="stat-label">
                            Toplam Ürün
                        </div>

                        <h3 class="stat-number">
                            @(ViewBag.TotalProducts ?? 0)
                        </h3>
                    </div>

                    <div class="stat-icon">
                        <i class="fa-solid fa-boxes-stacked"></i>
                    </div>

                </div>

            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">

                <div class="stat-top">

                    <div>
                        <div class="stat-label">
                            Toplam Kullanıcı
                        </div>

                        <h3 class="stat-number">
                            @(ViewBag.TotalUsers ?? 0)
                        </h3>
                    </div>

                    <div class="stat-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                </div>

            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">

                <div class="stat-top">

                    <div>
                        <div class="stat-label">
                            Bekleyen Talep
                        </div>

                        <h3 class="stat-number">
                            @(ViewBag.PendingRequests ?? 0)
                        </h3>
                    </div>

                    <div class="stat-icon">
                        <i class="fa-solid fa-file-circle-question"></i>
                    </div>

                </div>

            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card">

                <div class="stat-top">

                    <div>
                        <div class="stat-label">
                            Kritik Stok
                        </div>

                        <h3 class="stat-number">
                            @(ViewBag.CriticalStock ?? 0)
                        </h3>
                    </div>

                    <div class="stat-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>

                </div>

            </div>
        </div>

    </div>

    <h2 class="dashboard-section-title">
        Yönetim Modülleri
    </h2>

    <div class="row g-4">

        <div class="col-xl-3 col-md-6">

            <a asp-controller="Products"
               asp-action="Index"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>

                <h5>Ürün Yönetimi</h5>

                <p>
                    Ürünleri, barkodları, ürün kodlarını ve kritik stok
                    seviyelerini yönetin.
                </p>

                <span class="module-action">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

        <div class="col-xl-3 col-md-6">

            <a asp-controller="Warehouses"
               asp-action="Index"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-warehouse"></i>
                </div>

                <h5>Depo Yönetimi</h5>

                <p>
                    Depoları oluşturun, kapasite ve aktiflik durumlarını
                    yönetin.
                </p>

                <span class="module-action">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

        <div class="col-xl-3 col-md-6">

            <a asp-controller="WarehouseZones"
               asp-action="Index"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-layer-group"></i>
                </div>

                <h5>Depo Bölgeleri</h5>

                <p>
                    Hammadde, mamul, sevkiyat, kalite ve karantina
                    bölgelerini tanımlayın.
                </p>

                <span class="module-action">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

        <div class="col-xl-3 col-md-6">

            <a asp-controller="StorageLocations"
               asp-action="Index"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-table-cells-large"></i>
                </div>

                <h5>Raf ve Lokasyonlar</h5>

                <p>
                    Koridor, raf, kat ve göz bazında fiziksel depo
                    yerleşimini yönetin.
                </p>

                <span class="module-action">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

        <div class="col-xl-3 col-md-6">

            <a asp-controller="Requests"
               asp-action="Index"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-file-signature"></i>
                </div>

                <h5>Talep Yönetimi</h5>

                <p>
                    Departmanlardan gelen stok ve satın alma taleplerini
                    inceleyin.
                </p>

                <span class="module-action">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

        <div class="col-xl-3 col-md-6">

            <a asp-controller="Purchasing"
               asp-action="Dashboard"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-cart-shopping"></i>
                </div>

                <h5>Satın Alma</h5>

                <p>
                    Depo taleplerini ve satın alma operasyonlarını
                    görüntüleyin.
                </p>

                <span class="module-action">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

        <div class="col-xl-3 col-md-6">

            <a asp-controller="Users"
               asp-action="Index"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-users-gear"></i>
                </div>

                <h5>Kullanıcı Yönetimi</h5>

                <p>
                    Kullanıcı hesaplarını ve sistem rollerini yönetin.
                </p>

                <span class="module-action">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

        <div class="col-xl-3 col-md-6">

            <a asp-controller="Reports"
               asp-action="Index"
               class="module-card">

                <div class="module-icon">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>

                <h5>Raporlama</h5>

                <p>
                    Stok, talep ve operasyon raporlarını görüntüleyin.
                </p>

                <span class="module-action">
                    Modüle Git
                    <i class="fa-solid fa-arrow-right ms-1"></i>
                </span>

            </a>

        </div>

    </div>

</div>