@using StockOps.Models

@{
    ViewData["Title"] = "Depo Operasyonları";

    var lastTransactions =
        ViewBag.LastTransactions as List<StockTransaction>;

    var totalProducts =
        ViewBag.TotalProducts ?? 0;

    var totalRequests =
        ViewBag.TotalRequests ?? 0;

    var pendingStockOut =
        ViewBag.PendingStockOut ?? 0;

    var criticalStock =
        ViewBag.CriticalStock ?? 0;

    var availableLocations =
        ViewBag.AvailableLocations ?? 0;

    var occupiedLocations =
        ViewBag.OccupiedLocations ?? 0;

    var inactiveLocations =
        ViewBag.InactiveLocations ?? 0;

    var todayEntries =
        ViewBag.TodayEntries ?? 0;

    var todayExits =
        ViewBag.TodayExits ?? 0;
}

<style>
    .warehouse-dashboard {
        padding-bottom: 35px;
    }

    .dashboard-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

        .dashboard-heading h1 {
            margin-bottom: 5px;
            color: #0f172a;
            font-size: 2rem;
            font-weight: 900;
        }

        .dashboard-heading p {
            margin: 0;
            color: #64748b;
        }

    .dashboard-date {
        padding: 9px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        color: #475569;
        background: #ffffff;
        font-size: 0.88rem;
        font-weight: 700;
    }

    .overview-card {
        height: 100%;
        padding: 25px;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
    }

    .overview-card-title {
        margin-bottom: 20px;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
    }

    .warehouse-summary {
        padding: 22px;
        border-radius: 16px;
        color: #ffffff;
        background: linear-gradient( 135deg, #0f172a 0%, #1e293b 60%, #1e3a8a 100% );
    }

    .warehouse-summary-label {
        color: #cbd5e1;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .warehouse-summary-value {
        margin: 7px 0 18px;
        font-size: 2.1rem;
        font-weight: 900;
    }

    .summary-progress {
        height: 7px;
        overflow: hidden;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.16);
    }

    .summary-progress-bar {
        width: 64%;
        height: 100%;
        border-radius: 20px;
        background: #38bdf8;
    }

    .summary-footer {
        display: flex;
        justify-content: space-between;
        margin-top: 12px;
        color: #cbd5e1;
        font-size: 0.82rem;
    }

    .mini-stat-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-top: 18px;
    }

    .mini-stat {
        padding: 15px;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        background: #f8fafc;
    }

    .mini-stat-label {
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .mini-stat-value {
        margin-top: 5px;
        color: #0f172a;
        font-size: 1.45rem;
        font-weight: 900;
    }

    .status-list {
        display: flex;
        flex-direction: column;
        gap: 13px;
    }

    .status-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 15px;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        background: #ffffff;
    }

    .status-left {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .status-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        border-radius: 12px;
        color: #2563eb;
        background: #eff6ff;
    }

        .status-icon.warning {
            color: #d97706;
            background: #fffbeb;
        }

        .status-icon.danger {
            color: #dc2626;
            background: #fef2f2;
        }

    .status-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .status-value {
        color: #0f172a;
        font-size: 1.2rem;
        font-weight: 900;
    }

    .section-card {
        overflow: hidden;
        height: 100%;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
    }

    .section-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 18px 21px;
        border-bottom: 1px solid #e2e8f0;
    }

        .section-card-header h3 {
            margin: 0;
            color: #0f172a;
            font-size: 1rem;
            font-weight: 900;
        }

        .section-card-header a {
            color: #2563eb;
            font-size: 0.83rem;
            font-weight: 800;
            text-decoration: none;
        }

    .transactions-table {
        margin: 0;
    }

        .transactions-table thead th {
            padding: 12px 16px;
            color: #64748b;
            background: #f8fafc;
            font-size: 0.74rem;
            font-weight: 850;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .transactions-table tbody td {
            padding: 14px 16px;
            vertical-align: middle;
            color: #334155;
        }

    .transaction-type {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 0.76rem;
        font-weight: 800;
    }

        .transaction-type.entry {
            color: #166534;
            background: #dcfce7;
        }

        .transaction-type.exit {
            color: #991b1b;
            background: #fee2e2;
        }

    .location-chart {
        padding: 25px;
    }

    .donut-chart {
        position: relative;
        width: 210px;
        height: 210px;
        margin: 15px auto 25px;
        border-radius: 50%;
        background: conic-gradient( #2563eb 0deg 210deg, #38bdf8 210deg 305deg, #e2e8f0 305deg 360deg );
    }

        .donut-chart::after {
            content: "";
            position: absolute;
            inset: 38px;
            border-radius: 50%;
            background: #ffffff;
        }

    .donut-center {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .donut-center strong {
            color: #0f172a;
            font-size: 1.7rem;
            font-weight: 900;
        }

        .donut-center span {
            color: #64748b;
            font-size: 0.78rem;
        }

    .chart-legend {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .legend-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        color: #475569;
        font-size: 0.88rem;
    }

    .legend-name {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

        .legend-dot.occupied {
            background: #2563eb;
        }

        .legend-dot.available {
            background: #38bdf8;
        }

        .legend-dot.inactive {
            background: #e2e8f0;
        }

    .empty-state {
        padding: 45px 20px;
        color: #64748b;
        text-align: center;
    }

    @@media (max-width: 768px) {
        .dashboard-heading {
            display: block;
        }

        .dashboard-date {
            display: inline-block;
            margin-top: 15px;
        }

        .mini-stat-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="warehouse-dashboard">

    <div class="dashboard-heading">

        <div>
            <h1>Depo Dashboard</h1>

            <p>
                Stok, talep ve fiziksel depo operasyonlarını
                tek ekrandan takip edin.
            </p>
        </div>

        <div class="dashboard-date">
            <i class="fa-regular fa-calendar me-1"></i>
            @DateTime.Now.ToString("dd.MM.yyyy")
        </div>

    </div>

    <div class="row g-4">

        <div class="col-xl-8">

            <section class="overview-card">

                <h2 class="overview-card-title">
                    Depo Genel Durumu
                </h2>

                <div class="warehouse-summary">

                    <div class="warehouse-summary-label">
                        Toplam Ürün
                    </div>

                    <div class="warehouse-summary-value">
                        @totalProducts
                    </div>

                    <div class="summary-progress">
                        <div class="summary-progress-bar"></div>
                    </div>

                    <div class="summary-footer">
                        <span>Aktif stok kartları</span>
                        <span>%64 doluluk</span>
                    </div>

                </div>

                <div class="mini-stat-grid">

                    <div class="mini-stat">
                        <div class="mini-stat-label">
                            Toplam Talep
                        </div>

                        <div class="mini-stat-value">
                            @totalRequests
                        </div>
                    </div>

                    <div class="mini-stat">
                        <div class="mini-stat-label">
                            Kritik Stok
                        </div>

                        <div class="mini-stat-value">
                            @criticalStock
                        </div>
                    </div>

                    <div class="mini-stat">
                        <div class="mini-stat-label">
                            Bugünkü Giriş
                        </div>

                        <div class="mini-stat-value">
                            @todayEntries
                        </div>
                    </div>

                    <div class="mini-stat">
                        <div class="mini-stat-label">
                            Bugünkü Çıkış
                        </div>

                        <div class="mini-stat-value">
                            @todayExits
                        </div>
                    </div>

                </div>

            </section>

        </div>

        <div class="col-xl-4">

            <section class="overview-card">

                <h2 class="overview-card-title">
                    Operasyon Durumu
                </h2>

                <div class="status-list">

                    <div class="status-item">

                        <div class="status-left">
                            <div class="status-icon warning">
                                <i class="fa-solid fa-file-circle-question"></i>
                            </div>

                            <div>
                                <div class="status-label">
                                    Bekleyen Talep
                                </div>

                                <div class="status-value">
                                    @totalRequests
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="status-item">

                        <div class="status-left">
                            <div class="status-icon">
                                <i class="fa-solid fa-box-open"></i>
                            </div>

                            <div>
                                <div class="status-label">
                                    Stok Çıkışı Bekleyen
                                </div>

                                <div class="status-value">
                                    @pendingStockOut
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="status-item">

                        <div class="status-left">
                            <div class="status-icon danger">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>

                            <div>
                                <div class="status-label">
                                    Kritik Stok
                                </div>

                                <div class="status-value">
                                    @criticalStock
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </section>

        </div>

    </div>

    <div class="row g-4 mt-1">

        <div class="col-xl-8">

            <section class="section-card">

                <div class="section-card-header">

                    <h3>
                        Son Stok Hareketleri
                    </h3>

                    <a asp-controller="StockTransactions"
                       asp-action="Index">
                        Tümünü Gör
                        <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>

                </div>

                @if (lastTransactions == null ||
                     !lastTransactions.Any())
                {
                    <div class="empty-state">
                        Henüz stok hareketi bulunmuyor.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover transactions-table">

                            <thead>
                                <tr>
                                    <th>Ürün</th>
                                    <th>İşlem</th>
                                    <th>Miktar</th>
                                    <th>Depo</th>
                                    <th>Tarih</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in lastTransactions)
                                {
                                    <tr>

                                        <td>
                                            @(item.Product?.Name ?? "-")
                                        </td>

                                        <td>
                                            @{
                                                var isEntry =
                                                    item.TransactionType
                                                        .Contains(
                                                            "Giriş",
                                                            StringComparison
                                                                .OrdinalIgnoreCase);
                                            }

                                            <span class="transaction-type
                                                @(isEntry
                                                   ? "entry"
                                                   : "exit")">
                                                @item.TransactionType
                                            </span>
                                        </td>

                                        <td>
                                            @item.Quantity.ToString("N3")
                                        </td>

                                        <td>
                                            @(item.Warehouse?.Name ?? "-")
                                        </td>

                                        <td>
                                            @item.TransactionDate
                                            .ToString(
                                            "dd.MM.yyyy HH:mm")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>

        </div>

        <div class="col-xl-4">

            <section class="section-card">

                <div class="section-card-header">
                    <h3>Lokasyon Dağılımı</h3>
                </div>

                <div class="location-chart">

                    <div class="donut-chart">

                        <div class="donut-center">
                            <strong>
                                @(Convert.ToInt32(availableLocations) +
                                  Convert.ToInt32(occupiedLocations) +
                                  Convert.ToInt32(inactiveLocations))
                            </strong>

                            <span>Toplam Lokasyon</span>
                        </div>

                    </div>

                    <div class="chart-legend">

                        <div class="legend-item">
                            <span class="legend-name">
                                <span class="legend-dot occupied"></span>
                                Dolu
                            </span>

                            <strong>@occupiedLocations</strong>
                        </div>

                        <div class="legend-item">
                            <span class="legend-name">
                                <span class="legend-dot available"></span>
                                Boş
                            </span>

                            <strong>@availableLocations</strong>
                        </div>

                        <div class="legend-item">
                            <span class="legend-name">
                                <span class="legend-dot inactive"></span>
                                Pasif
                            </span>

                            <strong>@inactiveLocations</strong>
                        </div>

                    </div>

                </div>

            </section>

        </div>

    </div>

</div>