@model IEnumerable<StockOps.Models.WarehouseZone>

@{
    ViewData["Title"] = "Depo Bölgeleri";

    var warehouses =
        ViewBag.Warehouses as List<StockOps.Models.Warehouse>;

    var selectedWarehouse =
        ViewBag.SelectedWarehouse as StockOps.Models.Warehouse;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Depo Bölgeleri</h2>

            <p class="text-muted mb-0">
                Hammadde, mamul, sevkiyat ve diğer depo bölgelerini yönetin.
            </p>
        </div>

        <a asp-action="Create"
           asp-route-warehouseId="@selectedWarehouse?.Id"
           class="btn btn-primary">
            Yeni Bölge
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form method="get"
                  asp-action="Index"
                  class="row g-3 align-items-end">

                <div class="col-md-8">

                    <label class="form-label">
                        Depoya Göre Filtrele
                    </label>

                    <select name="warehouseId"
                            class="form-select">

                        <option value="">
                            Tüm Depolar
                        </option>

                        @if (warehouses != null)
                        {
                            foreach (var warehouse in warehouses)
                            {
                                if (selectedWarehouse?.Id == warehouse.Id)
                                {
                                    <option value="@warehouse.Id" selected>
                                        @warehouse.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@warehouse.Id">
                                        @warehouse.Name
                                    </option>
                                }
                            }
                        }

                    </select>

                </div>

                <div class="col-md-4">

                    <button type="submit"
                            class="btn btn-dark">
                        Filtrele
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Temizle
                    </a>

                </div>

            </form>

        </div>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    @if (selectedWarehouse != null)
                    {
                        <span>
                            @selectedWarehouse.Name Bölgeleri
                        </span>
                    }
                    else
                    {
                        <span>Tüm Depo Bölgeleri</span>
                    }

                </h5>

                <span class="badge bg-secondary">
                    Toplam: @Model.Count()
                </span>

            </div>

        </div>

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5>Henüz depo bölgesi bulunmuyor</h5>

                    <p class="text-muted">
                        İlk bölgeyi oluşturmak için yeni bölge butonunu kullanın.
                    </p>

                    <a asp-action="Create"
                       asp-route-warehouseId="@selectedWarehouse?.Id"
                       class="btn btn-primary">
                        Yeni Bölge Oluştur
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Depo</th>
                                <th>Bölge Kodu</th>
                                <th>Bölge Adı</th>
                                <th>Bölge Türü</th>
                                <th>Lokasyon Sayısı</th>
                                <th>Durum</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var zone in Model)
                            {
                                <tr>

                                    <td>
                                        @zone.Warehouse?.Name
                                    </td>

                                    <td>
                                        <span class="badge bg-dark">
                                            @zone.ZoneCode
                                        </span>
                                    </td>

                                    <td class="fw-semibold">
                                        @zone.Name
                                    </td>

                                    <td>
                                        @switch (zone.ZoneType)
                                        {
                                            case StockOps.Models.ZoneType.RawMaterial:
                                                <span>Hammadde</span>
                                                break;

                                            case StockOps.Models.ZoneType.FinishedProduct:
                                                <span>Mamul Ürün</span>
                                                break;

                                            case StockOps.Models.ZoneType.SemiFinishedProduct:
                                                <span>Yarı Mamul</span>
                                                break;

                                            case StockOps.Models.ZoneType.Shipment:
                                                <span>Sevkiyat</span>
                                                break;

                                            case StockOps.Models.ZoneType.QualityControl:
                                                <span>Kalite Kontrol</span>
                                                break;

                                            case StockOps.Models.ZoneType.Quarantine:
                                                <span>Karantina</span>
                                                break;

                                            case StockOps.Models.ZoneType.Waste:
                                                <span>Fire ve Atık</span>
                                                break;

                                            default:
                                                <span>Tanımsız</span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        @(zone.StorageLocations?.Count ?? 0)
                                    </td>

                                    <td>

                                        @if (zone.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Pasif
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="StorageLocations"
                                           asp-action="Index"
                                           asp-route-zoneId="@zone.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Raflar
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@zone.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            Düzenle
                                        </a>

                                        <form asp-action="ToggleStatus"
                                              asp-route-id="@zone.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary">
                                                @(zone.IsActive
                                                    ? "Pasif Yap"
                                                    : "Aktif Yap")
                                            </button>

                                        </form>

                                        <form asp-action="Delete"
                                              asp-route-id="@zone.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bu bölgeyi silmek istediğinize emin misiniz?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Sil
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>